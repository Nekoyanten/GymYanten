@model GymYanten.Models.Ejercicio
@{ ViewData["Title"] = "Editar Ejercicio"; }

<div class="page-head">
    <div>
        <div class="acento"></div>
        <div class="page-titulo">Editar Ejercicio</div>
        <div class="page-sub">@Model.Nombre</div>
    </div>
    <a class="btn-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div style="max-width:620px;">
    <div class="card">
        <div class="card-head"><span class="card-titulo">Modificar Datos</span></div>
        <div class="card-body">
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FechaCreacion" />

                <div class="form-grupo">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-ctrl" />
                    <span asp-validation-for="Nombre" class="form-error"></span>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div class="form-grupo">
                        <label asp-for="GrupoMuscular" class="form-label"></label>
                        <select asp-for="GrupoMuscular" class="form-ctrl" asp-items="Html.GetEnumSelectList<GymYanten.Models.GrupoMuscular>()"></select>
                        <span asp-validation-for="GrupoMuscular" class="form-error"></span>
                    </div>
                    <div class="form-grupo" style="display:flex;flex-direction:column;justify-content:flex-end;">
                        <div class="form-check-row" style="margin-bottom:0;padding-bottom:.65rem;">
                            <input asp-for="RequiereEquipo" type="checkbox" />
                            <label asp-for="RequiereEquipo" class="form-check-label">Requiere equipo</label>
                        </div>
                    </div>
                </div>
                <div class="form-grupo">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-ctrl"></textarea>
                </div>
                <div class="form-check-row">
                    <input asp-for="Activo" type="checkbox" />
                    <label asp-for="Activo" class="form-check-label">Activo en el catálogo</label>
                </div>
                <div style="display:flex;gap:.75rem;padding-top:.5rem;">
                    <button type="submit" class="btn-amarillo"><i class="bi bi-floppy-fill"></i> Guardar Cambios</button>
                    <a asp-action="Index" class="btn-outline">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
