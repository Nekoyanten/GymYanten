@model GymYanten.Models.Ejercicio
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo Ejercicio" : "Editar Ejercicio";
}

<div class="page-header">
    <div>
        <div class="page-title">@ViewData["Title"]</div>
        <div class="page-subtitle">Completa los datos del ejercicio</div>
    </div>
    <a class="btn-gym-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div style="max-width:600px;">
    <div class="card-gym">
        <div class="card-gym-body">
            <form asp-action="@(Model.Id == 0 ? "Crear" : "Editar")" method="post" class="form-gym">
                @Html.AntiForgeryToken()

                <div style="margin-bottom:1.2rem;">
                    <label asp-for="Nombre"></label>
                    <input asp-for="Nombre" placeholder="Ej: Press de banca" />
                    <span asp-validation-for="Nombre" class="field-validation-error"></span>
                </div>

                <div style="margin-bottom:1.2rem;">
                    <label asp-for="GrupoMuscular"></label>
                    <select asp-for="GrupoMuscular" asp-items="Html.GetEnumSelectList<GymYanten.Models.GrupoMuscular>()">
                        <option value="">-- Seleccionar --</option>
                    </select>
                    <span asp-validation-for="GrupoMuscular" class="field-validation-error"></span>
                </div>

                <div style="margin-bottom:1.2rem;">
                    <label asp-for="Descripcion"></label>
                    <textarea asp-for="Descripcion" rows="4" placeholder="Describe cómo se realiza el ejercicio..."></textarea>
                    <span asp-validation-for="Descripcion" class="field-validation-error"></span>
                </div>

                <div style="margin-bottom:1.8rem;display:flex;align-items:center;gap:.75rem;">
                    <input asp-for="RequiereEquipo" type="checkbox" style="width:16px;height:16px;accent-color:var(--accent);" />
                    <label asp-for="RequiereEquipo" style="text-transform:none;letter-spacing:0;font-size:.9rem;color:var(--text);margin:0;">
                        Este ejercicio requiere equipo o máquinas
                    </label>
                </div>

                <div style="display:flex;gap:.75rem;">
                    <button type="submit" class="btn-gym">
                        <i class="bi bi-floppy"></i> @(Model.Id == 0 ? "Crear Ejercicio" : "Guardar Cambios")
                    </button>
                    <a asp-action="Index" class="btn-gym-outline">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
