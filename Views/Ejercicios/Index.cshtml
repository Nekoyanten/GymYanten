@model IEnumerable<GymYanten.Models.Ejercicio>
@using GymYanten.Models
@{ ViewData["Title"] = "Ejercicios"; }

<div class="page-head">
    <div>
        <div class="acento"></div>
        <div class="page-titulo">Ejercicios</div>
        <div class="page-sub">Catálogo completo de ejercicios</div>
    </div>
    @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Entrenador))
    {
        <a class="btn-amarillo" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nuevo Ejercicio</a>
    }
</div>

<!-- Filtros -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body">
        <form method="get" asp-action="Index" style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;">
            <div style="flex:2;min-width:200px;">
                <label class="form-label">Buscar ejercicio</label>
                <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-ctrl" placeholder="Nombre del ejercicio..." />
            </div>
            <div style="flex:1;min-width:180px;">
                <label class="form-label">Grupo muscular</label>
                <select name="grupo" class="form-ctrl">
                    <option value="">Todos los grupos</option>
                    @foreach (GrupoMuscular g in ViewBag.Grupos)
                    {
                        <option value="@g" @(ViewBag.Grupo?.ToString() == g.ToString() ? "selected" : "")>@g</option>
                    }
                </select>
            </div>
            <div style="display:flex;gap:.5rem;padding-bottom:1px;">
                <button type="submit" class="btn-amarillo"><i class="bi bi-search"></i> Buscar</button>
                <a asp-action="Index" class="btn-outline">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card">
    <table class="tabla">
        <thead>
            <tr>
                <th>Ejercicio</th>
                <th>Grupo Muscular</th>
                <th>Requiere Equipo</th>
                <th>Descripción</th>
                <th style="text-align:right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>
                        <span style="font-weight:700;font-size:.95rem;">@e.Nombre</span>
                    </td>
                    <td><span class="badge badge-amarillo">@e.GrupoMuscular</span></td>
                    <td>
                        @if (e.RequiereEquipo)
                        {
                            <span class="badge badge-rojo"><i class="bi bi-tools"></i> Sí</span>
                        }
                        else
                        {
                            <span class="badge badge-gris">No</span>
                        }
                    </td>
                    <td style="color:var(--blanco3);max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.88rem;">
                        @e.Descripcion
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:.4rem;justify-content:flex-end;">
                            <a class="btn-outline" asp-action="Detalles" asp-route-id="@e.Id" title="Ver"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Entrenador))
                            {
                                <a class="btn-outline" asp-action="Editar" asp-route-id="@e.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a class="btn-peligro" asp-action="Eliminar" asp-route-id="@e.Id" title="Eliminar"><i class="bi bi-trash"></i></a>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">
                        <div class="empty">
                            <i class="bi bi-inbox"></i>
                            <p>No se encontraron ejercicios</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
