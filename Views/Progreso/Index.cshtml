@model IEnumerable<GymYanten.Models.ProgresoEntrenamiento>
@{
    ViewData["Title"] = "Mi Progreso";
}

<div class="page-header">
    <div>
        <div class="page-title">Mi Progreso</div>
        <div class="page-subtitle">Historial de entrenamiento</div>
    </div>
    <a class="btn-gym" asp-action="Registrar"><i class="bi bi-plus-lg"></i> Registrar Sesión</a>
</div>

<!-- Filtros -->
<div class="card-gym" style="margin-bottom:1.5rem;">
    <div class="card-gym-body">
        <form method="get" asp-action="Index" class="form-gym" style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;">
            <div style="flex:1;min-width:180px;">
                <label>Rutina</label>
                <select name="rutinaId">
                    <option value="">Todas las rutinas</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.Rutinas)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </div>
            <div style="flex:1;min-width:180px;">
                <label>Ejercicio</label>
                <select name="ejercicioId">
                    <option value="">Todos los ejercicios</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.Ejercicios)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </div>
            <div style="display:flex;gap:.5rem;">
                <button type="submit" class="btn-gym"><i class="bi bi-search"></i> Filtrar</button>
                <a asp-action="Index" class="btn-gym-outline">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de progreso -->
<div class="card-gym">
    <table class="table-gym">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Rutina</th>
                <th>Ejercicio</th>
                @if (!User.IsInRole("Cliente"))
                {
                    <th>Cliente</th>
                }
                <th>Series</th>
                <th>Reps</th>
                <th>Peso (kg)</th>
                <th>Notas</th>
                <th style="text-align:right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td style="font-weight:600;white-space:nowrap;">@p.Fecha.ToString("dd/MM/yyyy")</td>
                    <td style="color:var(--muted);">@p.Rutina?.Nombre</td>
                    <td>@p.Ejercicio?.Nombre</td>
                    @if (!User.IsInRole("Cliente"))
                    {
                        <td>@p.Cliente?.NombreCompleto</td>
                    }
                    <td><span class="badge-gym badge-yellow">@p.SeriesRealizadas</span></td>
                    <td>@p.Repeticiones</td>
                    <td>
                        @if (p.PesoUsadoKg.HasValue)
                        {
                            <span style="color:var(--accent);font-weight:600;">@p.PesoUsadoKg kg</span>
                        }
                        else
                        {

                            <span style="color:var(--muted);">—</span>
                        }
                    </td>
                    <td style="color:var(--muted);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                        @p.Notas
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:.5rem;justify-content:flex-end;">
                            <a class="btn-gym-outline" asp-action="Detalles" asp-route-id="@p.Id"><i class="bi bi-eye"></i></a>
                            <a class="btn-gym-outline" asp-action="Editar" asp-route-id="@p.Id"><i class="bi bi-pencil"></i></a>
                            <a class="btn-danger-gym" asp-action="Eliminar" asp-route-id="@p.Id"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" style="text-align:center;color:var(--muted);padding:3rem;">
                        <i class="bi bi-graph-up" style="font-size:2rem;display:block;margin-bottom:.5rem;"></i>
                        Sin registros de progreso aún. ¡Empieza hoy!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
