@model IEnumerable<GymYanten.Models.ProgresoEntrenamiento>
@{ ViewData["Title"] = "Mi Progreso"; }

<div class="page-head">
    <div>
        <div class="acento"></div>
        <div class="page-titulo">Mi Progreso</div>
        <div class="page-sub">Historial de sesiones de entrenamiento</div>
    </div>
    <div style="display:flex;gap:.6rem;align-items:center;">
        <a class="btn-outline"
           href="/ayuda/progreso.html"
           target="_blank"
           title="Guía Rápida: Módulo de Progreso"
           style="border-color:rgba(255,230,0,.4);color:var(--amarillo);gap:.4rem;">
            <i class="bi bi-question-circle-fill"></i> Ayuda
        </a>
        <a class="btn-amarillo" asp-action="Registrar"><i class="bi bi-plus-lg"></i> Registrar Sesión</a>
    </div>
</div>

<!-- Filtros -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body">
        <form method="get" asp-action="Index" style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;">
            <div style="flex:1;min-width:180px;">
                <label class="form-label">Rutina</label>
                <select name="rutinaId" class="form-ctrl">
                    <option value="">Todas las rutinas</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.Rutinas)
                    {
                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div style="flex:1;min-width:180px;">
                <label class="form-label">Ejercicio</label>
                <select name="ejercicioId" class="form-ctrl">
                    <option value="">Todos los ejercicios</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in ViewBag.Ejercicios)
                    {
                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div style="display:flex;gap:.5rem;padding-bottom:1px;">
                <button type="submit" class="btn-amarillo"><i class="bi bi-search"></i> Filtrar</button>
                <a asp-action="Index" class="btn-outline">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card">
    <table class="tabla">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Ejercicio</th>
                <th>Rutina</th>
                @if (!User.IsInRole("Cliente")) { <th>Cliente</th> }
                <th style="text-align:center;">Series</th>
                <th style="text-align:center;">Reps</th>
                <th style="text-align:center;">Peso</th>
                <th>Notas</th>
                <th style="text-align:right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td style="font-weight:700;white-space:nowrap;color:var(--amarillo);">
                        @p.Fecha.ToString("dd/MM/yyyy")
                    </td>
                    <td style="font-weight:600;">@p.Ejercicio?.Nombre</td>
                    <td style="color:var(--blanco3);font-size:.85rem;">@p.Rutina?.Nombre</td>
                    @if (!User.IsInRole("Cliente")) { <td>@p.Cliente?.NombreCompleto</td> }
                    <td style="text-align:center;"><span class="badge badge-amarillo">@p.SeriesRealizadas</span></td>
                    <td style="text-align:center;font-weight:600;">@p.Repeticiones</td>
                    <td style="text-align:center;">
                        @if (p.PesoUsadoKg.HasValue)
                        {
                            <span style="color:var(--amarillo);font-weight:700;">@p.PesoUsadoKg kg</span>
                        }
                        else { <span style="color:var(--blanco3);">—</span> }
                    </td>
                    <td style="color:var(--blanco3);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.85rem;">
                        @p.Notas
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;gap:.4rem;justify-content:flex-end;">
                            <a class="btn-outline" asp-action="Editar" asp-route-id="@p.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a class="btn-peligro" asp-action="Eliminar" asp-route-id="@p.Id" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="9">
                    <div class="empty">
                        <i class="bi bi-graph-up"></i>
                        <p>Sin registros de progreso. ¡Empieza hoy!</p>
                    </div>
                </td></tr>
            }
        </tbody>
    </table>
</div>
