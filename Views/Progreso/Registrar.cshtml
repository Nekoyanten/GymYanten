@model GymYanten.Models.ProgresoEntrenamiento
@{
    ViewData["Title"] = "Registrar Sesión";
}

<div class="page-header">
    <div>
        <div class="page-title">Registrar Sesión</div>
        <div class="page-subtitle">Anota tu entrenamiento de hoy</div>
    </div>
    <a class="btn-gym-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div style="max-width:600px;">
    <div class="card-gym">
        <div class="card-gym-body">
            <form asp-action="Registrar" method="post" class="form-gym">
                @Html.AntiForgeryToken()

                <div style="margin-bottom:1.2rem;">
                    <label asp-for="RutinaId">Rutina</label>
                    <select asp-for="RutinaId" asp-items="ViewBag.Rutinas">
                        <option value="">-- Seleccionar rutina --</option>
                    </select>
                    <span asp-validation-for="RutinaId" class="field-validation-error"></span>
                </div>

                <div style="margin-bottom:1.2rem;">
                    <label asp-for="EjercicioId">Ejercicio</label>
                    <select asp-for="EjercicioId" asp-items="ViewBag.Ejercicios">
                        <option value="">-- Seleccionar ejercicio --</option>
                    </select>
                    <span asp-validation-for="EjercicioId" class="field-validation-error"></span>
                </div>

                <div style="margin-bottom:1.2rem;">
                    <label asp-for="Fecha"></label>
                    <input asp-for="Fecha" type="date" />
                    <span asp-validation-for="Fecha" class="field-validation-error"></span>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-bottom:1.2rem;">
                    <div>
                        <label asp-for="SeriesRealizadas">Series</label>
                        <input asp-for="SeriesRealizadas" type="number" min="1" placeholder="4" />
                        <span asp-validation-for="SeriesRealizadas" class="field-validation-error"></span>
                    </div>
                    <div>
                        <label asp-for="Repeticiones">Reps</label>
                        <input asp-for="Repeticiones" type="number" min="1" placeholder="12" />
                        <span asp-validation-for="Repeticiones" class="field-validation-error"></span>
                    </div>
                    <div>
                        <label asp-for="PesoUsadoKg">Peso (kg)</label>
                        <input asp-for="PesoUsadoKg" type="number" step="0.5" min="0" placeholder="60" />
                    </div>
                </div>

                <div style="margin-bottom:1.8rem;">
                    <label asp-for="Notas"></label>
                    <textarea asp-for="Notas" rows="3" placeholder="¿Cómo te sentiste? ¿Algo que mejorar?"></textarea>
                </div>

                <div style="display:flex;gap:.75rem;">
                    <button type="submit" class="btn-gym"><i class="bi bi-floppy"></i> Guardar Progreso</button>
                    <a asp-action="Index" class="btn-gym-outline">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
