@model GymYanten.Models.ProgresoEntrenamiento
@{ ViewData["Title"] = "Eliminar Registro"; }

<div class="page-head">
    <div>
        <div class="acento"></div>
        <div class="page-titulo">Eliminar Registro</div>
    </div>
    <a class="btn-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div style="max-width:500px;">
    <div class="card" style="border-top:3px solid var(--rojo);">
        <div class="card-head">
            <span class="card-titulo" style="color:var(--rojo);">
                <i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación
            </span>
        </div>
        <div class="card-body">
            <p style="color:var(--blanco3);margin-bottom:1.5rem;font-size:.9rem;">
                Esta acción eliminará permanentemente este registro de entrenamiento. No se puede deshacer.
            </p>

            <div style="background:var(--negro3);border:1px solid var(--borde);
                        border-radius:var(--r);padding:1.25rem;margin-bottom:1.75rem;">
                <div style="font-weight:700;font-size:1rem;margin-bottom:.75rem;color:var(--amarillo);">
                    @Model.Fecha.ToString("dd/MM/yyyy")
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;font-size:.88rem;">
                    <div>
                        <span style="color:var(--blanco3);">Ejercicio: </span>
                        <span style="font-weight:600;">@Model.Ejercicio?.Nombre</span>
                    </div>
                    <div>
                        <span style="color:var(--blanco3);">Rutina: </span>
                        <span>@Model.Rutina?.Nombre</span>
                    </div>
                    <div>
                        <span style="color:var(--blanco3);">Series: </span>
                        <span style="font-weight:600;">@Model.SeriesRealizadas</span>
                    </div>
                    <div>
                        <span style="color:var(--blanco3);">Reps: </span>
                        <span style="font-weight:600;">@Model.Repeticiones</span>
                    </div>
                    @if (Model.PesoUsadoKg.HasValue)
                    {
                        <div>
                            <span style="color:var(--blanco3);">Peso: </span>
                            <span style="font-weight:600;color:var(--amarillo);">@Model.PesoUsadoKg kg</span>
                        </div>
                    }
                </div>
            </div>

            <form asp-action="Eliminar" method="post" style="display:flex;gap:.75rem;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn-peligro">
                    <i class="bi bi-trash-fill"></i> Sí, eliminar
                </button>
                <a asp-action="Index" class="btn-outline">Cancelar</a>
            </form>
        </div>
    </div>
</div>
