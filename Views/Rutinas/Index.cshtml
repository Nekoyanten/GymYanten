@model IEnumerable<GymYanten.Models.Rutina>
@using GymYanten.Models
@{ ViewData["Title"] = "Rutinas"; }

<div class="page-head">
    <div>
        <div class="acento"></div>
        <div class="page-titulo">Rutinas</div>
        <div class="page-sub">Programas de entrenamiento</div>
    </div>
    @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Entrenador))
    {
        <a class="btn-amarillo" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nueva Rutina</a>
    }
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem;">
    @foreach (var r in Model)
    {
        var nivelBadge = r.Nivel switch {
            NivelRutina.Principiante => "badge-verde",
            NivelRutina.Intermedio   => "badge-amarillo",
            NivelRutina.Avanzado     => "badge-rojo",
            _ => "badge-gris"
        };
        <div class="card" style="display:flex;flex-direction:column;border-top:2px solid var(--amarillo);">
            <div class="card-head">
                <span class="card-titulo">@r.Nombre</span>
                <span class="badge @nivelBadge">@r.Nivel</span>
            </div>
            <div class="card-body" style="flex:1;display:flex;flex-direction:column;gap:1rem;">
                <p style="color:var(--blanco3);font-size:.88rem;flex:1;">
                    @(r.Descripcion ?? "Sin descripción")
                </p>
                <div style="display:flex;gap:1.5rem;font-size:.8rem;color:var(--blanco3);border-top:1px solid var(--borde);padding-top:.85rem;">
                    <span><i class="bi bi-clock" style="color:var(--amarillo);"></i> @r.DuracionEstimadaMinutos min</span>
                    <span><i class="bi bi-person" style="color:var(--amarillo);"></i> @r.Entrenador?.NombreCompleto</span>
                </div>
                <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                    <a class="btn-outline" asp-action="Detalles" asp-route-id="@r.Id"><i class="bi bi-eye"></i> Ver</a>
                    @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Entrenador))
                    {
                        <a class="btn-outline" asp-action="Editar" asp-route-id="@r.Id"><i class="bi bi-pencil"></i> Editar</a>
                        <a class="btn-peligro" asp-action="Eliminar" asp-route-id="@r.Id"><i class="bi bi-trash"></i></a>
                    }
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div style="grid-column:1/-1;" class="card">
            <div class="empty">
                <i class="bi bi-calendar-x"></i>
                <p>No hay rutinas disponibles aún</p>
            </div>
        </div>
    }
</div>
