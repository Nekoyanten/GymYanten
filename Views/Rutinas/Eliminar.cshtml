@model GymYanten.Models.Rutina
@{ ViewData["Title"] = "Eliminar Rutina"; }

<div class="page-head">
    <div>
        <div class="acento"></div>
        <div class="page-titulo">Eliminar Rutina</div>
    </div>
    <a class="btn-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div style="max-width:500px;">
    <div class="card" style="border-top:3px solid var(--rojo);">
        <div class="card-head">
            <span class="card-titulo" style="color:var(--rojo);">
                <i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación
            </span>
        </div>
        <div class="card-body">
            <p style="color:var(--blanco3);margin-bottom:1.5rem;font-size:.9rem;">
                Esta acción desactivará la rutina del sistema. Los registros de progreso de los clientes se conservarán.
            </p>

            <div style="background:var(--negro3);border:1px solid var(--borde);border-radius:var(--r);padding:1.25rem;margin-bottom:1.75rem;">
                <div style="font-weight:700;font-size:1.05rem;margin-bottom:.5rem;">@Model.Nombre</div>
                <div style="display:flex;gap:1rem;font-size:.82rem;color:var(--blanco3);margin-bottom:.75rem;">
                    <span><i class="bi bi-clock" style="color:var(--amarillo);"></i> @Model.DuracionEstimadaMinutos min</span>
                    <span><i class="bi bi-person" style="color:var(--amarillo);"></i> @Model.Entrenador?.NombreCompleto</span>
                </div>
                <div style="color:var(--blanco3);font-size:.85rem;">@Model.Descripcion</div>
            </div>

            <form asp-action="Eliminar" method="post" style="display:flex;gap:.75rem;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn-peligro">
                    <i class="bi bi-trash-fill"></i> Sí, eliminar
                </button>
                <a asp-action="Index" class="btn-outline">Cancelar</a>
            </form>
        </div>
    </div>
</div>
