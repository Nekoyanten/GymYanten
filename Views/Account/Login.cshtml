@model GymYanten.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
}

<style>
    .auth-wrap { min-height: calc(100vh - 108px); display: flex; align-items: center; justify-content: center; }
    .auth-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); width: 100%; max-width: 420px; overflow: hidden; }
    .auth-header { background: var(--surface2); border-bottom: 1px solid var(--border); padding: 2rem; text-align: center; }
    .auth-logo { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; letter-spacing: 4px; color: var(--accent); }
    .auth-logo span { color: var(--accent2); }
    .auth-sub { font-size: .82rem; color: var(--muted); margin-top: .25rem; }
    .auth-body { padding: 2rem; }
    .field { margin-bottom: 1.25rem; }
    .remember-row { display: flex; align-items: center; gap: .5rem; margin-bottom: 1.5rem; }
    .remember-row input[type=checkbox] { width: 15px; height: 15px; accent-color: var(--accent); }
    .remember-row label { font-size: .83rem; color: var(--muted); text-transform: none; letter-spacing: 0; margin: 0; }
    .btn-full { width: 100%; justify-content: center; padding: .7rem; font-size: .9rem; }
    .auth-footer { text-align: center; margin-top: 1.25rem; font-size: .82rem; color: var(--muted); }
    .auth-footer a { color: var(--accent); text-decoration: none; }
    .val-errors { background: #1a0800; border: 1px solid var(--accent2); color: var(--accent2); padding: .75rem 1rem; border-radius: var(--radius); margin-bottom: 1rem; font-size: .85rem; }
    .val-errors ul { list-style: none; padding: 0; margin: 0; }
</style>

<div class="auth-wrap">
    <div class="auth-box">
        <div class="auth-header">
            <div class="auth-logo">GYM<span>SYS</span></div>
            <div class="auth-sub">Sistema de Gestión de Gimnasio</div>
        </div>
        <div class="auth-body">
            <div asp-validation-summary="All" class="val-errors"></div>
            <form asp-action="Login" method="post" class="form-gym">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="remember-row">
                    <input asp-for="RecordarMe" type="checkbox" />
                    <label asp-for="RecordarMe">Recordarme</label>
                </div>
                <button type="submit" class="btn-gym btn-full"><i class="bi bi-box-arrow-in-right"></i> Ingresar</button>
            </form>
            <div class="auth-footer">
                ¿No tienes cuenta? <a asp-action="Registro">Regístrate aquí</a>
            </div>
        </div>
    </div>
</div>