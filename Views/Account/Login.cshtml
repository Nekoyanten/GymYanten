@model GymYanten.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Ingresar"; Layout = "_Layout"; }

<style>
    .auth-page {
        min-height: calc(100vh - 64px - 52px);
        display: flex; align-items: center; justify-content: center;
        padding: 2rem;
        background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,230,0,.06) 0%, transparent 70%);
    }
    .auth-box { width: 100%; max-width: 420px; }
    .auth-brand {
        text-align: center; margin-bottom: 2.5rem;
    }
    .auth-brand-logo {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 3rem; letter-spacing: 6px; color: var(--blanco); line-height: 1;
    }
    .auth-brand-logo em { color: var(--amarillo); font-style: normal; }
    .auth-brand-sub { font-size: .8rem; color: var(--blanco3); letter-spacing: 2px; text-transform: uppercase; margin-top: .4rem; }
    .auth-card {
        background: var(--negro2);
        border: 1px solid var(--borde);
        border-top: 3px solid var(--amarillo);
        border-radius: var(--r);
        padding: 2rem;
    }
    .auth-titulo {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1.4rem; font-weight: 700; letter-spacing: 2px;
        text-transform: uppercase; margin-bottom: 1.5rem; color: var(--blanco2);
    }
    .auth-footer { text-align: center; margin-top: 1.25rem; font-size: .83rem; color: var(--blanco3); }
    .auth-footer a { color: var(--amarillo); text-decoration: none; font-weight: 600; }
    .auth-footer a:hover { text-decoration: underline; }
    .btn-full { width: 100%; justify-content: center; padding: .75rem; font-size: .88rem; }
</style>

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-brand">
            <div class="auth-brand-logo">GYM<em>YANTEN</em></div>
            <div class="auth-brand-sub">Sistema de Gestión</div>
        </div>
        <div class="auth-card">
            <div class="auth-titulo">Iniciar Sesión</div>
            <div asp-validation-summary="All" class="val-errors"></div>
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="form-grupo">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-ctrl" type="email" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>

                <div class="form-grupo">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-ctrl" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>

                <div class="form-check-row" style="margin-bottom:1.5rem;">
                    <input asp-for="RecordarMe" type="checkbox" />
                    <label asp-for="RecordarMe" class="form-check-label">Recordar mi sesión</label>
                </div>

                <button type="submit" class="btn-amarillo btn-full">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar al Sistema
                </button>
            </form>
            <div class="auth-footer">
                ¿No tienes cuenta? <a asp-action="Registro">Regístrate aquí</a>
            </div>
        </div>
    </div>
</div>
