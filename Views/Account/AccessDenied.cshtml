@{ ViewData["Title"] = "Acceso Denegado"; }

<style>
    .denied-wrap {
        min-height: calc(100vh - 116px);
        display: flex; align-items: center; justify-content: center;
        text-align: center; padding: 2rem;
    }
</style>

<div class="denied-wrap">
    <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:6rem;
                    color:var(--rojo);line-height:1;margin-bottom:1rem;">403</div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:1.8rem;
                    letter-spacing:3px;margin-bottom:1rem;">ACCESO DENEGADO</div>
        <p style="color:var(--blanco3);font-size:.92rem;max-width:380px;
                  margin:0 auto 2rem;">
            No tienes permisos para acceder a esta sección. Contacta al administrador si crees que esto es un error.
        </p>
        <div style="display:flex;gap:.75rem;justify-content:center;">
            <a class="btn-amarillo" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-fill"></i> Ir al Inicio
            </a>
            <a class="btn-outline" onclick="history.back()">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>
