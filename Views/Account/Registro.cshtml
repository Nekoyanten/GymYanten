@model GymYanten.Models.ViewModels.RegistroViewModel
@{ ViewData["Title"] = "Crear Cuenta"; Layout = "_Layout"; }

<style>
    .auth-page {
        min-height: calc(100vh - 64px - 52px);
        display: flex; align-items: center; justify-content: center;
        padding: 2rem;
        background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,230,0,.06) 0%, transparent 70%);
    }
    .auth-box { width: 100%; max-width: 500px; }
    .auth-card {
        background: var(--negro2); border: 1px solid var(--borde);
        border-top: 3px solid var(--amarillo); border-radius: var(--r); padding: 2rem;
    }
    .auth-titulo {
        font-family: 'Barlow Condensed', sans-serif; font-size: 1.4rem; font-weight: 700;
        letter-spacing: 2px; text-transform: uppercase; margin-bottom: .25rem; color: var(--blanco2);
    }
    .auth-sub { font-size: .82rem; color: var(--blanco3); margin-bottom: 1.75rem; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .btn-full { width: 100%; justify-content: center; padding: .75rem; font-size: .88rem; margin-top: .25rem; }
    .auth-footer { text-align: center; margin-top: 1.25rem; font-size: .83rem; color: var(--blanco3); }
    .auth-footer a { color: var(--amarillo); text-decoration: none; font-weight: 600; }
</style>

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-card">
            <div class="auth-titulo">Crear Cuenta</div>
            <div class="auth-sub">Completa tus datos para registrarte como cliente</div>

            <div asp-validation-summary="All" class="val-errors"></div>

            <form asp-action="Registro" method="post">
                @Html.AntiForgeryToken()
                <div class="grid-2">
                    <div class="form-grupo">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-ctrl" placeholder="Juan" />
                        <span asp-validation-for="Nombre" class="form-error"></span>
                    </div>
                    <div class="form-grupo">
                        <label asp-for="Apellido" class="form-label"></label>
                        <input asp-for="Apellido" class="form-ctrl" placeholder="Pérez" />
                        <span asp-validation-for="Apellido" class="form-error"></span>
                    </div>
                </div>
                <div class="form-grupo">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-ctrl" type="email" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>
                <div class="form-grupo">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-ctrl" placeholder="+57 300 000 0000" />
                </div>
                <div class="grid-2">
                    <div class="form-grupo">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-ctrl" type="password" placeholder="Mín. 8 caracteres" />
                        <span asp-validation-for="Password" class="form-error"></span>
                    </div>
                    <div class="form-grupo">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <input asp-for="ConfirmarPassword" class="form-ctrl" type="password" placeholder="Repite contraseña" />
                        <span asp-validation-for="ConfirmarPassword" class="form-error"></span>
                    </div>
                </div>
                <button type="submit" class="btn-amarillo btn-full">
                    <i class="bi bi-person-check-fill"></i> Crear mi Cuenta
                </button>
            </form>
            <div class="auth-footer">
                ¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>
            </div>
        </div>
    </div>
</div>
